{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(python *)",
      "Bash(.venv/Scripts/python *)",
      "Bash(pip *)",
      "Bash(.venv/Scripts/pip *)",
      "Bash(pytest*)",
      "Bash(ruff *)",
      "Bash(kaggle *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git branch*)",
      "Bash(ls*)",
      "Bash(dir*)"
    ],
    "deny": [
      "Read(./kaggle.json)",
      "Read(~/.kaggle/kaggle.json)",
      "Edit(./data/raw/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/format-on-save.ps1",
            "timeout": 30,
            "statusMessage": "ruff format"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/block-dangerous-bash.ps1",
            "timeout": 15,
            "statusMessage": "safety check"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/notify.ps1",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ]
  }
}
